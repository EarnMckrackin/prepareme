{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "vercel-python@3.0.0",
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
