# Default model provider used when the form doesn't specify one.
# One of: gateway | gemini | groq | grok | openai | openrouter | anthropic
PREP_BACKEND=gemini

# Optional: force a specific model id (otherwise a sensible default per provider is used)
# Gateway model IDs use provider/model form, e.g. openai/gpt-5.4
# OpenRouter model IDs also use provider/model form, e.g. openai/gpt-4o-mini
# PREP_MODEL=openai/gpt-5.4

# Vercel AI Gateway key. If set and PREP_BACKEND is omitted, the app defaults to gateway.
AI_GATEWAY_API_KEY=

# Optional shared rate limiting via Upstash Redis / Vercel KV REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Vercel Blob persistence. Off by default to avoid publishing user material.
PREP_STORE_COURSES=0
PREP_BLOB_ACCESS=public
BLOB_READ_WRITE_TOKEN=

# Provider API keys — set the one(s) you want available server-side or use BYOK.
# Free tiers: Gemini (https://aistudio.google.com/apikey), Groq (https://console.groq.com/keys)
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# Paid fallbacks:
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PrepareMe
ANTHROPIC_API_KEY=

# Optional web search source used by the generator form.
TAVILY_API_KEY=
