# Default model provider used when the form doesn't specify one.
# One of: gateway | gemini | groq | grok | openai | openrouter | anthropic
PREP_BACKEND=gemini

# Optional: force a specific model id (otherwise a sensible default per provider is used)
# Gateway model IDs use provider/model form, e.g. openai/gpt-5.4
# OpenRouter public traffic defaults to openrouter/free unless an access code grants paid use.
# PREP_MODEL=openai/gpt-5.4

# Library/API gates.
# Public visitors can only see these course IDs. Use "*" to make the whole library public.
PREP_LIBRARY_PUBLIC_IDS=gen-ai-learning-lab
# Username/passcode auth. Use "*" in library for all courses.
# PREP_AUTH_USERS={"devin":{"passcode":"change-me","library":["*"],"openrouter_paid":true},"guest":{"passcode":"guest-code","library":["grayscale-interview-prep"]}}
PREP_AUTH_USERS=
# Optional signing secret for auth cookies. Defaults to PREP_ADMIN_ACCESS_CODE if omitted.
PREP_AUTH_SECRET=
# Optional admin shortcut with access to all private courses and paid OpenRouter models.
PREP_ADMIN_ACCESS_CODE=
# Optional legacy per-user access code map. Example:
# PREP_ACCESS_CODES={"alice-code":{"user":"alice","library":["grayscale-interview-prep","grayscale-ppm-mastery"],"openrouter_paid":true},"bob-code":{"user":"bob","library":["grayscale-interview-prep"]}}
PREP_ACCESS_CODES=

# OpenRouter public users can only use these zero-cost models through your server key.
# OpenRouter documents openrouter/free as a router for currently available free models.
PREP_OPENROUTER_FREE_MODELS=openrouter/free
# Paid models are only shown to access-code users with "openrouter_paid": true.
PREP_OPENROUTER_PAID_MODELS=openai/gpt-4o-mini,anthropic/claude-sonnet-4
# PREP_OPENROUTER_PAID_MODEL=openai/gpt-4o-mini

# Vercel AI Gateway key. If set and PREP_BACKEND is omitted, the app defaults to gateway.
AI_GATEWAY_API_KEY=

# Optional shared rate limiting via Upstash Redis / Vercel KV REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Vercel Blob persistence. Off by default to avoid publishing user material.
PREP_STORE_COURSES=0
PREP_BLOB_ACCESS=public
BLOB_READ_WRITE_TOKEN=

# Provider API keys — set the one(s) you want available server-side or use BYOK.
# Free tiers: Gemini (https://aistudio.google.com/apikey), Groq (https://console.groq.com/keys)
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# Paid fallbacks:
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=PrepareMe
ANTHROPIC_API_KEY=

# Optional web search source used by the generator form.
TAVILY_API_KEY=
